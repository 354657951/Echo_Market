{
  "name": "echo-market",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server.mjs",
    "dev:all": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api\" \"npm:dev\"",
    "db:generate": "drizzle-kit generate",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "tsc && vite build --mode github-pages",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
